# Variables del contenedor en el VPS. Copia este archivo a `.env.vps` en el
# servidor y rellenalo con los valores reales. `.env.vps` NO se sube al
# repositorio: lleva las llaves de R2, de OpenAI y el secreto de las sesiones.
#
# El perfil `prod` no tiene valores por defecto para casi nada, y es
# deliberado: una variable que falta impide arrancar en vez de tirar de un
# valor de desarrollo. Si el contenedor no levanta, el log dice cual falta.

SPRING_PROFILES_ACTIVE=prod

# --- Puerto interno del contenedor en el host -------------------------------
# 18084 es de direccion360. Este es el siguiente libre; si lo cambias, cambialo
# tambien en nginx/metricol.conf.
APP_PORT=18085

# --- Base de datos ----------------------------------------------------------
# La instancia de Cloud SQL es la misma que usa direccion360
# (cmrg-505321:us-central1:cmrg), con una base distinta. Hay que crearla antes:
#   gcloud sql databases create metricol --instance=cmrg
# La URL no se pone aqui: la arma docker-compose apuntando al proxy.
DB_NAME=metricol
DB_USER=
DB_PASS=

# --- A donde vuelve el navegador y quien puede llamar a la API --------------
# APP_BASE_URL es el FRONTEND, no esta API. De aqui cuelga la pagina puente
# `/social-connected.html` a la que upload-post devuelve a la persona al
# terminar de conectar sus redes; si apunta a la API, ese viaje acaba en un
# 401 y la app se queda esperando para siempre.
APP_BASE_URL=https://
# Los origenes que consumen la API, separados por coma: el panel web y, si
# aplica, el build web de la app. Sin esto el perfil prod no arranca.
CORS_ALLOWED_ORIGINS=https://

# --- Sesiones ---------------------------------------------------------------
# Cadena larga y aleatoria, propia de este entorno. Cambiarla cierra todas las
# sesiones abiertas. Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_DAYS=15

# --- Medios (Cloudflare R2) -------------------------------------------------
# Las cinco son obligatorias en prod. Son las mismas que ya usas en local: el
# bucket no cambia por desplegar.
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# --- Publicar en redes ------------------------------------------------------
# Opcional: sin llave, la plataforma entera sigue en pie y solo conectar una
# red avisa de que falta configurarla. Permite desplegar antes de tenerla.
UPLOAD_POST_API_KEY=
UPLOAD_POST_BASE_URL=https://api.upload-post.com/api

# --- Sugerencias de texto ---------------------------------------------------
# Opcional: sin llave solo se apaga la IA.
OPENAI_API_KEY=
OPENAI_API_MODEL=gpt-4o-mini
# Precio del modelo de arriba, en dolares por millon de tokens: con esto se
# calcula el gasto por workspace. Si se cambia de modelo, se cambian tambien.
# Estos son los de gpt-4o-mini; confirmarlos en https://openai.com/api/pricing
OPENAI_PRICING_INPUT_PER_1M_USD=0.15
OPENAI_PRICING_OUTPUT_PER_1M_USD=0.60

# --- Correo saliente (recuperar contrasena e invitaciones) -----------------
# Se envia por SMTP de Resend. Sin llave no falla nada, pero tampoco sale nada:
# el codigo de recuperacion y el enlace de la invitacion se quedan en el log.
#
# Lo mas facil es correr "bash configurar-correo.sh": pide la llave sin
# mostrarla, la pone en este archivo de la VM y recrea el contenedor.
#
# La llave de API de Resend (https://resend.com/api-keys), empieza con "re_".
MAIL_PASSWORD=
# El remitente. Su dominio tiene que estar VERIFICADO en Resend (Domains, con
# sus registros DNS en Cloudflare, nube en gris), o Resend rechaza el envio y el
# codigo "nunca llega".
MAIL_FROM=notificaciones@picale.rodtech.cloud
# Estos tres ya traen el valor de Resend: solo se definen para cambiar de
# proveedor SMTP. El usuario de Resend es literalmente "resend".
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=resend

# --- Cobros (Stripe) ------------------------------------------------------------
# Vacio = cobros apagados: la app funciona igual y no se le cobra a nadie. Hoy la
# API todavia no tiene el codigo que cobra; esto deja lista la configuracion.
#
# Lo mas facil es correr "bash configurar-stripe.sh": pide los valores sin
# mostrarlos, los pone en este archivo de la VM y recrea el contenedor.
#
# EMPIEZA CON LAS DE PRUEBA. El modo lo dice la propia clave: sk_test_ mueve
# dinero de mentira; sk_live_ mueve el de verdad.
#
# Clave secreta: Developers > API keys.
STRIPE_SECRET_KEY=
# Secreto de firma (whsec_...) del endpoint https://picale.rodtech.cloud/api/v1/billing/webhook
# (Developers > Webhooks). Sin el, ningun aviso de Stripe se acepta.
# Eventos: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
# El id (price_...) del precio mensual de un espacio de trabajo. El monto y la
# moneda se cambian en Stripe, no aqui.
STRIPE_PRICE_WORKSPACE=

# --- Zona horaria -------------------------------------------------------------
# La app manda la hora local SIN zona y el servidor la compara con su propio
# reloj. Con el contenedor en UTC, una publicacion programada a las 14:00 de
# Mexico salia a las 08:00. Esta es la zona de quienes usan la app hoy;
# docker-compose la toma de aqui.
TZ=America/Mexico_City

# --- Operacion ----------------------------------------------------------------
# Llave para /api/v1/ops/** (gasto de IA por workspace), en la cabecera
# X-Ops-Key. Algo largo y aleatorio. Vacia = esos endpoints contestan 404.
OPS_API_KEY=

# --- ffmpeg -----------------------------------------------------------------
# La imagen lo trae instalado y en el PATH, asi que no hace falta tocar esto.
# Se deja anotado porque si un dia el contenedor no lo encuentra, las fotos se
# publican sin adaptar y el sintoma aparece lejos de la causa.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# --- Entrar con Google ------------------------------------------------------
# El client id del cliente WEB, NO el de Android: Google identifica al APK por
# su paquete y su huella SHA-1, y el token que emite va dirigido a este cliente.
# Sin esto, la app avisa de que falta configurar Google en el servidor.
GOOGLE_OAUTH_CLIENT_ID=
# No lo lee nadie del codigo hoy; se deja por si se anade el flujo de servidor.
GOOGLE_SECRET=

# --- Base de datos: detalles opcionales -------------------------------------
# Tienen valor por defecto correcto para Postgres; se listan para que se vea
# que existen. `SPRING_DATASOURCE_URL` NO va aqui: la arma docker-compose
# apuntando al proxy de Cloud SQL, y ponerla a mano se contradiria con eso.
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# --- Cuenta de demostracion para Google Play (opcional) ---------------------
# Con las dos primeras llenas, la API crea esa cuenta al arrancar si no existe
# (ver DemoAccountInitializer). Si ya existe no la toca. Vacias = no hace nada.
# Los valores reales van SOLO en el .env.vps del servidor, nunca aqui.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=
DEMO_ACCOUNT_ORGANIZATION=Picale HUB
